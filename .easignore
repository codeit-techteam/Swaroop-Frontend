# Upload rules for EAS Build. Same secret exclusions as .gitignore, except
# google-services.json and GoogleService-Info.plist are uploaded from this
# machine so Android FCM builds can see the local client config.
# Those files are still gitignored and must not be committed.

node_modules/
.expo/
dist/
web-build/
expo-env.d.ts

*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.ipa
*.apk
*.aab

.metro-health-check*

.env
.env.*
!.env.example
*.env
.envrc
.secrets/

*service-account*.json
*serviceAccount*.json
*firebase-adminsdk*.json
firebase-service-account.json
credentials.json
*-credentials.json

PolyStoreX_TDS_Audit_Report*.xlsx

npm-debug.*
yarn-debug.*
yarn-error.*
*.log

.DS_Store
*.pem
Thumbs.db

*.tsbuildinfo
coverage/

.idea/
.vscode/
.cursor/
*.swp
*.swo

artifacts/
tmp/
