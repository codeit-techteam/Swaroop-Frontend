# PolyStoreX mobile — environment template
#
# Local:  cp .env.example .env   then fill secrets in .env (never commit it).
# Production and preview builds read public values from eas.json.
# Maps, Firebase, and OneSignal secrets stay in .env or EAS secrets, not in git.
# EXPO_PUBLIC_* values are readable inside the APK. Do not put a server key,
# service-account private key, or unrestricted Google key in this file.

EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_API_BASE_URL=https://swaroop-backend-xzwkz.ondigitalocean.app/api/v1
EXPO_PUBLIC_IMAGE_BASE_URL=https://pub-f184fe06f7d24c68978e25682f5fd785.r2.dev
# Optional. Address search + reverse geocoding go through the backend
# (/api/v1/locations/*), so the app does not need a Places/Geocoding key.
# Only set this for a native Maps SDK, restricted to Android package
# com.polystorex.app (+ SHA-1) / iOS bundle com.polystorex.app and the Maps SDK APIs.
# Never reuse the backend GOOGLE_MAPS_SERVER_API_KEY here: EXPO_PUBLIC_* values
# are readable inside the APK.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Unused by the Android push path. Push uses google-services.json
# (Firebase polystorex-7b42a, package com.polystorex.app) and the native FCM
# device token. Leave these as placeholders.
# Do not paste a service-account private key into this file.
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=polystorex-7b42a
EXPO_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id

# EAS Updates (optional)
EXPO_PUBLIC_UPDATES_URL=https://u.expo.dev/d7ee56b4-eddd-4799-ad34-19706aa78ebd
