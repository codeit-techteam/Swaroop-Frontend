# PolyStoreX mobile — environment TEMPLATE (safe to commit)
#
# Local:  cp .env.example .env
# Then fill real values in `.env` (never commit `.env`).
#
# EXPO_PUBLIC_* values ship inside the APK — never put server keys,
# service-account JSON, unrestricted Maps keys, or auth tokens here.
# Preview/production builds usually take public URLs from eas.json / EAS secrets.

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=3.1.4
EXPO_PUBLIC_API_BASE_URL=https://your-api-host.example.com/api/v1
EXPO_PUBLIC_IMAGE_BASE_URL=https://your-cdn.example.com

# Optional Maps SDK browser/native key (package/bundle restricted). Leave empty if unused.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase / OneSignal placeholders — real values from EAS secrets or local `.env`
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id

# EAS Updates (optional)
EXPO_PUBLIC_UPDATES_URL=https://u.expo.dev/your-eas-project-id
