# Swaroop Environment Variables
# Copy this file to .env and fill in your values

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_IMAGE_BASE_URL=https://cdn.example.com
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id

# EAS (Expo Application Services)
EAS_PROJECT_ID=3771775e-6e10-45f2-9752-72d51ce2f55f
