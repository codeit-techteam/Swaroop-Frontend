# Copy to `.env` for local Expo. Production builds use eas.json env.
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_API_BASE_URL=https://swaroop-backend-xzwkz.ondigitalocean.app/api/v1
EXPO_PUBLIC_IMAGE_BASE_URL=https://pub-f184fe06f7d24c68978e25682f5fd785.r2.dev
# Optional. Address search + reverse geocoding go through the backend
# (/api/v1/locations/*), so the app does not need a Places/Geocoding key.
# Only set this for a native Maps SDK, restricted to Android package
# com.swaroop.app (+ SHA-1) / iOS bundle com.swaroop.app and the Maps SDK APIs.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id

# EAS Updates (optional)
EXPO_PUBLIC_UPDATES_URL=https://u.expo.dev/8fa5420d-cb2b-4656-bc7a-411b977c9d7b
